{
  "name": "readme-generator-monorepo",
  "version": "1.0.0",
  "description": "Production README Generator SaaS Monorepo",
  "scripts": {
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "test:server": "npm --prefix server test",
    "dev": "node -e \"console.log('To run both: in terminal 1: cd server && npm start, in terminal 2: cd client && npm run dev')\""
  }
}