# Server Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/readme_generator

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_readme_gen_12345
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_readme_gen_67890
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Client & OAuth URLs
FRONTEND_URL=http://localhost:5173
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback

# Optional AI Assistant Integration
AI_API_KEY=